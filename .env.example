# Production builds (Vercel, droplet, etc.) always use this.
BASE_API_URL=https://api.foodiestopia.com

# `npm run dev` uses this. Pick ONE. Restart `npm run dev` after changing it.

# Local API (also run `dotnet run` on port 5001):
BASE_API_URL_DEVELOPMENT=http://localhost:5001

# Laptop UI + droplet API (no local `dotnet run`):
# BASE_API_URL_DEVELOPMENT=https://api.foodiestopia.com
